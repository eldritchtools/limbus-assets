  "quests": {
    "assign_agent": {
      "condition": {
        "min": 1,
        "type": "department_agents"
      },
      "description": "Agents can only work on subjects in their own department. Each department can hold up to five agents. Go to Facility to begin assigning agents.",
      "name": "Assign an agent to a department",
      "requires": [
        "hire_first_agent"
      ],
      "reward": {
        "currency": 1000
      }
    },
    "assign_subject": {
      "condition": {
        "min": 1,
        "type": "department_subjects"
      },
      "description": "Agents only work on subjects in their own department. Each department can hold up to four subjects. Go to Facility to begin assigning subjects.",
      "name": "Assign a research subject to a department",
      "requires": [
        "assign_agent"
      ],
      "reward": {
        "currency": 1000
      }
    },
    "first_expedition": {
      "condition": {
        "min": 1,
        "type": "expedition_count"
      },
      "description": "Hire another agent and send them out on an expedition in the Expeditions tab. Expeditions cost money, but give agents xp and rewards you with new equipment. Some expeditions may unlock new research subjects when cleared for the first time.",
      "name": "Sent your agents out on your first expedition",
      "requires": [
        "schedule_work"
      ],
      "reward": {
        "currency": 3000
      }
    },
    "first_expedition_complete": {
      "condition": {
        "min": 1,
        "type": "expedition_cleared_count"
      },
      "description": "Expeditions are much more demanding on your agents than working in the facility. They require them to fight multiple waves of enemies with no breaks in between to heal. Make sure they are prepared appropriately before sending them out.",
      "name": "Complete your first expedition",
      "requires": [
        "first_expedition"
      ],
      "reward": {
        "currency": 5000
      }
    },
    "first_level_up": {
      "condition": {
        "min": 2,
        "type": "agent_level"
      },
      "description": "Work earns XP. Each level grants increased stats and points to spend on offense ratings.",
      "name": "Level up an agent",
      "requires": [
        "first_research_2"
      ],
      "reward": {
        "currency": 3000
      }
    },
    "first_research": {
      "condition": {
        "type": "research_started"
      },
      "description": "Each work block is one real life hour. Check back later to see how your agent fared.",
      "name": "Start researching a subject",
      "requires": [
        "schedule_work"
      ],
      "reward": {
        "currency": 1000
      }
    },
    "first_research_2": {
      "condition": {
        "type": "none"
      },
      "description": "When completing a work block, the agent will receive a work result depending on their and the subject's stats. Good results will give more rewards and xp and deal less HP and SP damage to the agent. Bad results will give less rewards and deal more damage.",
      "name": "Start researching a subject (2)",
      "requires": [
        "first_research"
      ],
      "reward": {
        "currency": 1000
      }
    },
    "first_research_level_up": {
      "condition": {
        "min": 1,
        "type": "research_level"
      },
      "description": "Good and average work results grant research XP. Each level grants a small boost to effective work efficiency when doing work on the subject and may unlock things like purchaseable equipment.",
      "name": "Reach research level 1 on a subject",
      "requires": [
        "first_research_2"
      ],
      "reward": {
        "currency": 3000
      }
    },
    "hire_first_agent": {
      "condition": {
        "min": 1,
        "type": "agent_count"
      },
      "description": "Go to Agents, open the hiring menu, click hire, and choose a candidate from one of the options.",
      "name": "Hire your first agent",
      "reward": {
        "currency": 2000
      }
    },
    "intro_complete": {
      "condition": {
        "type": "none"
      },
      "description": "This ends the introduction to the game. You are now ready to explore the game's systems yourself. Here's a small gift to help you get started!",
      "name": "Introduction complete",
      "requires": [
        "first_level_up",
        "first_research_level_up",
        "first_expedition_complete"
      ],
      "reward": {
        "currency": 25000,
        "weapon": "W-0"
      }
    },
    "schedule_work": {
      "condition": {
        "type": "work_scheduled"
      },
      "description": "Pick a subject for at least one block of an agent's schedule. Leave other blocks as breaks. An agent's schedule is a cycle. They will return to the start after completing the final block.",
      "name": "Schedule some work",
      "requires": [
        "assign_subject"
      ],
      "reward": {
        "currency": 2000
      }
    }
  },
